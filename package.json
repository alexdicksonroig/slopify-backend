{
  "name": "slopify-backend",
  "version": "1.0.0",
  "keywords": [],
  "license": "ISC",
  "author": "alexdicksonroig",
  "type": "module",
  "main": "app.ts",
  "scripts": {
    "start": "pnpm build:ts && node dist/main.js",
    "fmt": "oxfmt",
    "fmt:check": "oxfmt --check",
    "lint": "oxlint",
    "lint:fix": "oxlint --fix",
    "build:ts": "tsc",
    "dev": "tsx watch --env-file=.env src/main.ts",
    "db:up": "docker compose --env-file .env up -d postgres",
    "db:down": "docker compose --env-file .env down",
    "db:logs": "docker compose --env-file .env logs -f postgres",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio"
  },
  "dependencies": {
    "@aws-sdk/client-s3": "3.1095.0",
    "@fastify/autoload": "6.0.0",
    "@fastify/cors": "11.3.0",
    "@fastify/multipart": "10.1.0",
    "@fastify/sensible": "6.0.0",
    "@fastify/static": "10.1.2",
    "@fastify/swagger": "9.8.1",
    "@fastify/swagger-ui": "6.1.0",
    "dotenv": "17.4.2",
    "drizzle-orm": "0.45.2",
    "fastify": "5.0.0",
    "fastify-plugin": "5.0.0",
    "file-type": "22.0.1",
    "postgres": "3.4.9",
    "sharp": "0.35.3"
  },
  "devDependencies": {
    "@types/node": "25.0.3",
    "drizzle-kit": "0.31.10",
    "oxfmt": "0.62.0",
    "oxlint": "1.77.0",
    "pino-pretty": "13.1.3",
    "tsx": "4.20.6",
    "typescript": "5.9.2"
  }
}
